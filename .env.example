# Copie para .env (cp .env.example .env) e ajuste. NUNCA commite o .env.

# --- Django ---------------------------------------------------------------------
# Gere com: uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
DJANGO_DEBUG=True
# Settings usado pelo manage.py/gunicorn: config.settings.dev | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev
# Lista separada por vírgulas
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origens com esquema, ex.: https://api.seudominio.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

# --- Banco de dados -------------------------------------------------------------
# Desenvolvimento (docker-compose local):
DATABASE_URL=postgres://financeiro:financeiro@localhost:5432/financeiro
#
# Produção — Supabase, Session pooler (porta 5432), sempre com sslmode=require.
# Pegue em: Supabase > Project > Connect > Session pooler. Formato:
# DATABASE_URL=postgres://postgres.<ref-do-projeto>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
#
# Tempo (s) de reuso das conexões. 0 = fecha a cada request.
DB_CONN_MAX_AGE=60
# Só para o Transaction pooler (porta 6543): DB_DISABLE_SERVER_SIDE_CURSORS=True e DB_CONN_MAX_AGE=0
DB_DISABLE_SERVER_SIDE_CURSORS=False

# --- Postgres local (docker-compose) --------------------------------------------
POSTGRES_VERSION=17
POSTGRES_DB=financeiro
POSTGRES_USER=financeiro
POSTGRES_PASSWORD=financeiro
POSTGRES_PORT=5432

# --- JWT ------------------------------------------------------------------------
JWT_ACCESS_MINUTOS=15
JWT_REFRESH_DIAS=7
# Opcional: chave própria para assinar os tokens (padrão: DJANGO_SECRET_KEY).
# JWT_SIGNING_KEY=

# --- CORS / throttling ----------------------------------------------------------
# Origens do PWA, separadas por vírgula, ex.: https://app.seudominio.com.br
CORS_ALLOWED_ORIGINS=http://localhost:5173
THROTTLE_LOGIN=5/min
THROTTLE_REGISTRO=10/hour
# Proxies confiáveis na frente (IP real via X-Forwarded-For). Dev: 0. Produção: 1.
DRF_NUM_PROXIES=0

# --- Produção (Docker / Easypanel) ----------------------------------------------
# Roda migrate + createcachetable ao subir o container.
RODAR_MIGRATIONS=true
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=30
# Padrão True. False só para rodar a imagem de produção em http://localhost.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=2592000
